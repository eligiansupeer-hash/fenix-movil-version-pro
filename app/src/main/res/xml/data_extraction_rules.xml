<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de extracción de datos: desactivadas por completo
  (allowBackup=false en manifest). El rootfs y las credenciales
  nunca salen del dispositivo (seguridad.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
